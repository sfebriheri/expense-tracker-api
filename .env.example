# Server
NODE_ENV=development
PORT=3000

# Database (used by the app container / local dev)
DATABASE_URL=postgres://expense_user:expense_pass@localhost:5432/expense_tracker

# Postgres container settings (used by docker-compose)
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=expense_pass
POSTGRES_DB=expense_tracker

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
